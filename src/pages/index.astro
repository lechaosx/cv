---
import { existsSync } from 'node:fs';
import { getEntry } from 'astro:content';
import '@fontsource-variable/roboto/wght.css';
import '@fontsource-variable/roboto-condensed/wght.css';
import '../../scss/style.scss';
import Timeline from '../components/Timeline.astro';
import Icon from '../components/Icon.astro';

const entry = await getEntry('cv', 'cv');
if (!entry) throw new Error('Missing src/content/cv.yaml');
const { data } = entry;
if (data.photo && !existsSync(`public${data.photo}`)) throw new Error(`Missing photo: ${data.photo}`);
const labels = data.language === 'cs'
  ? { about: 'O mně', interests: 'Zájmy', connect: 'Kontakty', experience: 'Pracovní zkušenosti', education: 'Vzdělání', present: 'současnost' }
  : { about: 'About Me', interests: 'Interests', connect: 'Connect', experience: 'Work Experience', education: 'Education', present: 'present' };
const theme = Object.entries(data.theme).filter(([, value]) => value).map(([key, value]) => `--${key}: ${value?.startsWith('--') ? `var(${value})` : value}`).join(';');
---
<!doctype html>
<html lang={data.language} style={theme}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{data.name}</title>
    {data.description && <meta name="description" content={data.description} />}
    <link rel="canonical" href={Astro.site} />
    {data.photo && <link rel="icon" href={data.photo} />}
  </head>
  <body>
    <main>
      <figure class="photo">
        {data.photo ? <img src={data.photo} alt={data.name} width="400" /> : <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 100 100" aria-hidden="true"><circle cx="50" cy="50" r="50" fill="var(--white)" /><circle cx="50" cy="38" r="18" fill="var(--light)" /><ellipse cx="50" cy="90" rx="30" ry="22" fill="var(--light)" /></svg>}
      </figure>
      <header class="main-info">
        <div>
          <p class="title">{data.title_before_name}</p>
          <h1>{data.name}</h1>
          <p class="title">{data.title_after_name}</p>
          <p class="position">{data.position}</p>
        </div>
        <address class="contact-list">
          {data.location && <div><Icon name="map-pin" /><span>{data.location}</span></div>}
          {data.phone && <div><Icon name="phone" /><a href={`tel:${data.phone}`}><span>{data.phone}</span></a></div>}
          {data.email && <div><Icon name="mail" /><a href={`mailto:${data.email}`}><span>{data.email}</span></a></div>}
        </address>
      </header>
      <div class="additional-info">
        {data.description && <section><h2 class="section-header">{labels.about}</h2><p>{data.description}</p></section>}
        {data.interests.length > 0 && <section><h2 class="section-header">{labels.interests}</h2><ul class="badge-list">{data.interests.map(interest => <li>{interest}</li>)}</ul></section>}
        {data.links.length > 0 && <section class="connect"><h2 class="section-header">{labels.connect}</h2><ul>{data.links.map(link => <li><a href={link.url}><Icon name={link.icon} /><span>{link.label}</span></a></li>)}</ul></section>}
      </div>
      <div>
        {data.experience.length > 0 && <section><h2 class="section-header">{labels.experience}</h2><Timeline entries={data.experience} present={labels.present} /></section>}
        {data.education.length > 0 && <section><h2 class="section-header">{labels.education}</h2><Timeline entries={data.education} present={labels.present} /></section>}
      </div>
    </main>
  </body>
</html>
