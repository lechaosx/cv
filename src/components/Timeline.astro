---
import { formatDate, type TimelineEntry } from '../cv';
interface Props { entries: TimelineEntry[]; present: string }
const { entries, present } = Astro.props;
---
<div class="timeline">
  {entries.map(entry => (
    <article>
      <div>
        <strong>{entry.organization}</strong>
        {entry.department && <div>{entry.department}</div>}
        {(entry.start_year || entry.end_year) && <p class="cv-dates">
          {entry.start_year ? <>
            <time datetime={`${entry.start_year}${entry.start_month ? `-${entry.start_month}` : ''}`}>{formatDate(entry.start_month, entry.start_year)}</time>
            {' – '}
            {entry.end_year ? <time datetime={`${entry.end_year}${entry.end_month ? `-${entry.end_month}` : ''}`}>{formatDate(entry.end_month, entry.end_year)}</time> : present}
          </> : <time datetime={`${entry.end_year}${entry.end_month ? `-${entry.end_month}` : ''}`}>{formatDate(entry.end_month, entry.end_year)}</time>}
        </p>}
        {entry.badges.length > 0 && <ul class="badge-list">{entry.badges.map(badge => <li>{badge}</li>)}</ul>}
      </div>
      <div>
        <strong>{entry.title}</strong>
        {entry.description && <p>{entry.description}</p>}
      </div>
    </article>
  ))}
</div>
