---
import { dateTime, type LocalizedCV, type Language } from '../cv';
import { renderedText } from '../i18n';
interface Props { entries: LocalizedCV['experience']; present: string; language: Language }
const { entries, present, language } = Astro.props;
const t = (value: string) => renderedText(value, language);
---
<div class="timeline">
  {entries.map(entry => (
    <article>
      <div>
        <strong>{t(entry.organization)}</strong>
        {entry.department && <div>{t(entry.department)}</div>}
        {(entry.from || entry.to) && <p class="cv-dates">
          {entry.from ? <>
            <time datetime={dateTime(entry.from)}>{entry.from}</time>
            {entry.from !== entry.to && <>{' – '}{entry.to ? <time datetime={dateTime(entry.to)}>{entry.to}</time> : present}</>}
          </> : <time datetime={dateTime(entry.to)}>{entry.to}</time>}
        </p>}
        {entry.badges.length > 0 && <ul class="badge-list">{entry.badges.map(badge => <li>{t(badge)}</li>)}</ul>}
      </div>
      <div>
        <strong>{t(entry.title)}</strong>
        {entry.description && <p>{t(entry.description)}</p>}
      </div>
    </article>
  ))}
</div>
