---
import type { CV, Language } from '../cv';
import { renderedText } from '../i18n';
import Icon from './Icon.astro';

interface Props {
  links: CV['links'];
  heading: string;
  language: Language;
}

const { links, heading, language } = Astro.props;
---
<section class="connect">
  <h2 class="section-header">{heading}</h2>
  <ul>{links.map(link => <li><a href={link.url}><Icon name={link.icon} /><span>{renderedText(link.label, language).split(/(?<=[./@])/).map(part => <>{part}<wbr /></>)}</span></a></li>)}</ul>
</section>
