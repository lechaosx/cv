---
import { existsSync } from 'node:fs';
import '@fontsource-variable/roboto/wght.css';
import '@fontsource-variable/roboto-condensed/wght.css';
import '@fontsource-variable/roboto-condensed/wght-italic.css';
import '../../scss/style.scss';
import Prose from './Prose.astro';
import Timeline from './Timeline.astro';
import { localizeCV, type CV, type Language } from '../cv';
import { labels as translations, renderedText, preferredLanguage } from '../i18n';
import { pageMetadata, structuredData } from '../publishing';
import Icon from './Icon.astro';
import Connect from './Connect.astro';
import PageSettings from './PageSettings.astro';

interface Props { cv: CV; language: Language; neutral?: boolean }
const { cv, language, neutral = false } = Astro.props;
const data = localizeCV(cv, language);
const site = Astro.site!;
const meta = pageMetadata(cv, language, site);
const t = (value: string) => renderedText(value, language);
if (data.photo && !existsSync(`public${data.photo}`)) throw new Error(`Missing photo: ${data.photo}`);
const labels = translations[language];
const theme = Object.entries(data.theme).filter(([, value]) => value).map(([key, value]) => `--${key}: ${value}`).join(';');
---
<!doctype html>
<!--
  👀 Caught you peeking!

  Since you're here: https://github.com/lechaosx/cv
-->
<html lang={data.language} style={theme || undefined}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{meta.title}</title>
    <meta name="description" content={meta.description} />
    <link rel="canonical" href={meta.url} />
    {(['en', 'cs'] as const).map(lang => <link rel="alternate" hreflang={lang} href={new URL(`/${lang}/`, site)} />)}
    <link rel="alternate" hreflang="x-default" href={site} />
    <link rel="alternate" type="text/markdown" href={new URL(`/${language}/index.md`, site)} />
    <link rel="describedby" type="text/plain" href={new URL('/llms.txt', site)} />
    <meta property="og:type" content="profile" />
    <meta property="og:title" content={meta.title} />
    <meta property="og:description" content={meta.description} />
    <meta property="og:url" content={meta.url} />
    <meta property="og:locale" content={language === 'cs' ? 'cs_CZ' : 'en_US'} />
    <meta property="og:locale:alternate" content={language === 'cs' ? 'en_US' : 'cs_CZ'} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={meta.title} />
    <meta name="twitter:description" content={meta.description} />
    {meta.image && <>
      <meta property="og:image" content={meta.image} />
      <meta property="og:image:alt" content={data.name} />
      <meta name="twitter:image" content={meta.image} />
      <meta name="twitter:image:alt" content={data.name} />
    </>}
    <script is:inline type="application/ld+json" set:html={structuredData(cv, language, site)} />
    {data.photo && <link rel="icon" href={data.photo} />}
    <script is:inline>
      try {
        const theme = localStorage.getItem('theme');
        if (theme === 'light' || theme === 'dark') document.documentElement.dataset.theme = theme;
      } catch {}
    </script>
    {neutral && <script is:inline set:html={`
      let saved = null;
      try { saved = localStorage.getItem('lang'); } catch {}
      const language = (${preferredLanguage.toString()})(saved, navigator.languages);
      location.replace('/' + language + '/' + location.search + location.hash);
    `} />}
  </head>
  <body>
    <main>
      <figure class="photo">
        {data.photo ? <img src={data.photo} alt={data.name} width="400" /> : <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 100 100" aria-hidden="true"><circle cx="50" cy="50" r="50" fill="var(--white)" /><circle cx="50" cy="38" r="18" fill="var(--light)" /><ellipse cx="50" cy="90" rx="30" ry="22" fill="var(--light)" /></svg>}
      </figure>
      <header class="main-info">
        <div>
          {data.title_before_name && <p class="title">{t(data.title_before_name)}</p>}
          <h1>{t(data.name)}</h1>
          {data.title_after_name && <p class="title">{t(data.title_after_name)}</p>}
          <p class="position">{t(data.position)}</p>
          {data.headline && <p class="headline">{t(data.headline)}</p>}
        </div>
        <address class="contact-list">
          {data.location && <div><Icon name="map-pin" /><span>{t(data.location)}</span></div>}
          {data.phone && <div><Icon name="phone" /><a href={`tel:${data.phone.replace(/[ ()-]/g, '')}`}><span>{data.phone}</span></a></div>}
          {data.email && <div><Icon name="mail" /><a href={`mailto:${data.email}`}><span>{data.email.split(/(?<=[@.])/).map(part => <>{part}<wbr /></>)}</span></a></div>}
        </address>
      </header>
      <div class="additional-info">
        {data.description && <section><h2 class="section-header">{t(labels.about)}</h2><Prose source={data.description} language={language} /></section>}
        {data.interests.length > 0 && <section><h2 class="section-header">{t(labels.interests)}</h2><ul class="badge-list">{data.interests.map(interest => <li>{t(interest)}</li>)}</ul></section>}
        {data.links.length > 0 && <Connect links={data.links} heading={labels.connect} language={language} />}
        <PageSettings language={language} name={data.name} />
      </div>
      <div>
        {data.experience.length > 0 && <section><h2 class="section-header">{t(labels.experience)}</h2><Timeline entries={data.experience} present={labels.present} language={language} /></section>}
        {data.education.length > 0 && <section><h2 class="section-header">{t(labels.education)}</h2><Timeline entries={data.education} present={labels.present} language={language} /></section>}
      </div>
      <div class="connect-footer">
        {data.links.length > 0 && <Connect links={data.links} heading={labels.connect} language={language} />}
        <PageSettings language={language} name={data.name} />
      </div>
    </main>
    <script>
      import '../page-controls';
    </script>
  </body>
</html>
