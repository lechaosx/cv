---
import type { Language } from '../cv';
import { labels } from '../i18n';

interface Props { language: Language; name: string }
const { language, name } = Astro.props;
const filename = [name.normalize('NFD').replace(/\p{M}/gu, '').replace(/[^a-zA-Z0-9]+/g, '_').replace(/^_|_$/g, ''), 'CV', language.toUpperCase()].filter(Boolean).join('_') + '.pdf';
const text = labels[language];
const targetLanguage = language === 'cs' ? 'en' : 'cs';
const targetLabel = targetLanguage === 'cs' ? 'Čeština' : 'English';
---
<nav class="page-settings" aria-label={text.controls}>
  <a class="language-switch" href={`/${targetLanguage}/`} lang={targetLanguage} hreflang={targetLanguage} data-language={targetLanguage} aria-label={targetLabel} title={targetLabel}>
    <span aria-hidden="true">{targetLanguage.toUpperCase()}</span>
  </a>
  <a href={`/${language}/cv.pdf`} download={filename} aria-label={text.downloadPDF} title={text.downloadPDF}>
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3v12m-5-5 5 5 5-5M5 17v4h14v-4" /></svg>
  </a>
  <button type="button" class="theme-control" data-light-label={text.switchToLight} data-dark-label={text.switchToDark} aria-label={text.switchToDark} title={text.switchToDark} hidden>
    <svg class="theme-icon-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="4" /><path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41" /></svg>
    <svg class="theme-icon-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79Z" /></svg>
  </button>
</nav>
